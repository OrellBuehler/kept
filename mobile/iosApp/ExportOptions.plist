<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TestFlight and App Store distribution share this export method. -->
	<key>method</key>
	<string>app-store-connect</string>
	<!-- Manual signing with a self-managed distribution identity. The release
	     workflow imports the Apple Distribution certificate (.p12) into a
	     temporary keychain and installs the App Store provisioning profile
	     before export; export then re-signs the app with them. teamID is not
	     stored here: the workflow injects it from the APPLE_TEAM_ID secret.
	     The profile name below must match the name of the App Store
	     provisioning profile created for ch.orellbuehler.kept in the Apple
	     Developer portal (the profile stored in IOS_PROFILE_APP_BASE64). -->
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>ch.orellbuehler.kept</key>
		<string>Kept App Store</string>
	</dict>
	<!-- The build number is set explicitly in CI (CURRENT_PROJECT_VERSION from
	     the run number); don't let export rewrite it. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<!-- Upload dSYMs so Xcode Organizer can symbolicate crashes. -->
	<key>uploadSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
