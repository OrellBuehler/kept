DATABASE_PATH=./data/kept.db

# Where uploaded bills are stored (in a documents/ subfolder). Defaults to the directory of
# DATABASE_PATH. Setting it on an existing install does not move documents/; move it yourself.
# KEPT_STORAGE_DIR=./data

# Keep uploaded files in an S3-compatible bucket instead of on disk (default: fs). The bucket must
# exist. Existing documents/ are not copied over. Path-style addressing (MinIO, Garage, SeaweedFS)
# is the default; use KEPT_S3_VIRTUAL_HOSTED_STYLE=true for AWS S3. See the README, "S3 storage".
# KEPT_STORAGE=s3
# KEPT_S3_BUCKET=kept
# KEPT_S3_ENDPOINT=http://localhost:9000
# KEPT_S3_REGION=us-east-1
# KEPT_S3_ACCESS_KEY_ID=
# KEPT_S3_SECRET_ACCESS_KEY=
# KEPT_S3_PREFIX=
# KEPT_S3_VIRTUAL_HOSTED_STYLE=false

# 32 random bytes, base64 (generate with: openssl rand -base64 32). Required in production.
KEPT_SECRET_KEY=

# Set to false only when serving over plain HTTP (e.g. a LAN setup).
# KEPT_COOKIE_SECURE=false

# Reverse proxy (svelte-adapter-bun). ORIGIN must match the public URL or form
# posts fail with 403 "Cross-site POST form submissions are forbidden".
# Login rate limiting keys on the client address: behind a proxy set
# ADDRESS_HEADER (e.g. X-Forwarded-For) and XFF_DEPTH (number of trusted proxies),
# otherwise every client appears as the proxy and shares one limit.
# ORIGIN=https://kept.example.com
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
